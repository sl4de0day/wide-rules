{
  "name": "wide-rules",
  "version": "0.2101126",
  "description": "Unified Vulnerability Database and DecisionCore Multi-Agent Primitives for the Wide Ecosystem",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./rules": "./dist/rules.json",
    "./decision": {
      "types": "./src/decision/index.d.ts",
      "default": "./src/decision/index.js"
    }
  },
  "scripts": {
    "validate": "node scripts/validate.cjs",
    "bundle": "node scripts/bundle.cjs",
    "test": "node scripts/test-decision.cjs && node scripts/test-rules.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sl4de0day/wide-rules.git"
  },
  "keywords": [
    "security-rules",
    "sast",
    "ast-patterns",
    "vulnerability-database",
    "decisioncore",
    "multi-agent",
    "appsec",
    "devsecops",
    "wide",
    "wide-ecosystem"
  ],
  "author": "sl4de0day",
  "license": "MIT",
  "devDependencies": {
    "js-yaml": "^4.1.0"
  }
}
