{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WideSecurityRule",
  "type": "object",
  "required": [
    "id",
    "name",
    "category",
    "severity",
    "languages",
    "message"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^wide/[a-z0-9_-]+$"
    },
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "cwe": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"]
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pattern": {
      "type": "string"
    },
    "not-match": {
      "type": "string"
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "message": {
      "type": "string"
    },
    "why": {
      "type": "string"
    },
    "remediation": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
