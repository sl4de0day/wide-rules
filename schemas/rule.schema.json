{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WideSecurityRule",
  "type": "object",
  "required": [
    "id",
    "name",
    "category",
    "severity",
    "languages",
    "message"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^wide/[a-z0-9_-]+$"
    },
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "INJECTION",
        "AUTH",
        "NETWORK",
        "SECRETS",
        "DESERIALIZATION",
        "FILESYSTEM",
        "PROTOTYPE",
        "XSS",
        "CRYPTO",
        "AI_SECURITY",
        "LOGIC",
        "GENERAL"
      ]
    },
    "cwe": {
      "type": "string"
    },
    "cve": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "severity": {
      "type": "string",
      "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"]
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pattern": {
      "type": "string"
    },
    "not-match": {
      "type": "string"
    },
    "source-pattern": {
      "type": "string"
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "message": {
      "type": "string"
    },
    "why": {
      "type": "string"
    },
    "remediation": {
      "type": "string"
    },
    "instruction": {
      "type": "string"
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "source": { "type": "string" },
        "kev": { "type": "boolean" },
        "epss": { "type": "number" },
        "learnedAt": { "type": "string" },
        "advisoryUrl": { "type": "string" }
      },
      "additionalProperties": true
    },
    "tests": {
      "type": "object",
      "properties": {
        "positive": {
          "type": "array",
          "items": { "type": "string" }
        },
        "negative": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
